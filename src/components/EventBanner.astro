---
import events from '../data/events.json';
import { activePeriods, bannerEndDay } from '../lib/event-calendar.mjs';
const banners = events.items.filter(event => 'banner' in event && event.banner);
const dateFormat = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric' });
const bannerDates = (event: typeof banners[number]) => `${dateFormat.format(new Date(event.datetime))}–${dateFormat.format(new Date(bannerEndDay(event)!))}`;
const active = new Set(activePeriods(banners).map(event => event.calendarId));
---
<aside class="site-announcements" aria-label="Current announcements" hidden={!active.size}>
  {banners.map(event => <div class="site-announcement" data-banner-id={event.calendarId} data-start={event.datetime} data-end={bannerEndDay(event)} hidden={!active.has(event.calendarId)}>
    <strong>{event.banner}</strong><span>{bannerDates(event)}</span><a href={event.url} target="_blank" rel="noreferrer">View details ↗</a>
  </div>)}
</aside>
<script>
  import { easternDateKey } from '../lib/calendar-month.mjs';
  const container = document.querySelector<HTMLElement>('.site-announcements')!;
  const banners = Array.from(container.querySelectorAll<HTMLElement>('[data-banner-id]'));
  function refreshBanners() {
    const today = easternDateKey(new Date());
    banners.forEach(banner => { banner.hidden = !(banner.dataset.start! <= today && banner.dataset.end! >= today); });
    container.hidden = banners.every(banner => banner.hidden);
  }
  refreshBanners();
  window.setInterval(refreshBanners,30_000);
  window.addEventListener('pageshow',refreshBanners);
  document.addEventListener('visibilitychange',()=>{ if (!document.hidden) refreshBanners(); });
</script>
