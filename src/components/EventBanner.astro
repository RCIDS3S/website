---
import events from '../data/events.json';
import { eventAnnouncements, announcementIsActive } from '../lib/event-announcements.mjs';
const banners = eventAnnouncements(events.items);
const now = Date.now();
const active = new Set(banners.filter(banner => announcementIsActive(banner, now)).map(banner => banner.id));
---
<aside class="site-announcements" aria-label="Current announcements" hidden={!active.size}>
  {banners.map(banner => <div class="site-announcement" data-banner-id={banner.id} data-start={banner.start} data-end={banner.end} hidden={!active.has(banner.id)}>
    <strong>{banner.title}</strong>{banner.detail && <span>{banner.detail}</span>}<a href={banner.href} target={banner.external ? '_blank' : undefined} rel={banner.external ? 'noreferrer' : undefined} data-view-event={!banner.external ? banner.id : undefined} aria-label={`View ${banner.title}`}>{banner.external ? 'View details ↗' : 'View event'}</a>
  </div>)}
</aside>
<script>
  import { announcementIsActive } from '../lib/event-announcements.mjs';
  const container = document.querySelector<HTMLElement>('.site-announcements')!;
  const banners = Array.from(container.querySelectorAll<HTMLElement>('[data-banner-id]'));
  function refreshBanners() {
    const now = Date.now();
    banners.forEach(banner => { banner.hidden = !announcementIsActive({ start: banner.dataset.start!, end: banner.dataset.end! }, now); });
    container.hidden = banners.every(banner => banner.hidden);
  }
  refreshBanners();
  window.setInterval(refreshBanners,30_000);
  window.addEventListener('pageshow',refreshBanners);
  document.addEventListener('visibilitychange',()=>{ if (!document.hidden) refreshBanners(); });
</script>
